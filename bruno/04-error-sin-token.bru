meta {
  name: 04 Error 401 sin token
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/validar
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "capture_store_name": "Soriana",
    "facade_b64": "{{facade_b64}}",
    "product_b64": "{{product_b64}}",
    "shelf_b64": "{{shelf_b64}}"
  }
}

assert {
  res.status: eq 401
  res.body.error: isString
}

docs {
  Sin el header X-Api-Key la API responde 401 y no gasta tokens.
}
