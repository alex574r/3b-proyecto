meta {
  name: 03 Validar con fotos de archivo
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/validar
  body: json
  auth: none
}

headers {
  X-Api-Key: {{token}}
  Content-Type: application/json
}

body:json {
  {}
}

script:pre-request {
  // Requiere Developer Mode: ajustes de la colección > Security > JavaScript Sandbox. En Safe Mode `fs` no existe.
  // Coloca fachada.jpg, producto.jpg y etiqueta.jpg en la carpeta indicada por la variable photosDir.
  const fs = require('fs');
  const dir = bru.getEnvVar('photosDir');
  const b64 = (name) => fs.readFileSync(`${dir}/${name}`).toString('base64');
  req.setBody({
    capture_id: 'BRUNO-ARCHIVOS-' + Date.now(),
    capture_store_name: 'Soriana',
    capture_price: 14.0,
    capture_brand: 'Cat-tit',
    product_name: 'Arena para gato',
    unit_product: 'gramo',
    unit_quantity_product: 2000,
    facade_b64: b64('fachada.jpg'),
    product_b64: b64('producto.jpg'),
    shelf_b64: b64('etiqueta.jpg')
  });
}

assert {
  res.status: eq 200
}

tests {
  test("devuelve el registro de captura (forma de capturas.json) y el detalle del motor", function () {
    expect(Object.keys(res.body)).to.deep.equal([
      "capture_id", "capture_store_name", "capture_date", "capture_barcode", "capture_price", "capture_brand",
      "id_product", "product_name", "product_barcode", "product_price", "min_product_price", "max_product_price",
      "unit_product", "unit_quantity_product", "product_group", "product_line",
      "facade_file", "facade_url", "product_file", "product_url", "shelf_file", "shelf_url",
      "decision_esperada", "motivo_rechazo",
      "confidence_score", "reason_code", "validaciones", "precio_detectado", "precio_descuento",
      "codigo_barras_detectado", "explicacion", "fuente_producto", "fuente_catalogo"
    ]);
  });
}

docs {
  Error "Cannot find module fs": la colección está en Safe Mode. Cámbiala a Developer Mode (ajustes de la colección > Security).
  No uses las fotos del set de 3B: pasan por la red de Cloudflare y las reglas del reto piden mantenerlas dentro del equipo.
}
